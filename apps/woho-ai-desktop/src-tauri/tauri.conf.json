{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "WoHo AI",
  "version": "0.1.0",
  "identifier": "in.wohotech.ai",
  "build": {
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "WoHo AI",
        "width": 1280,
        "height": 800,
        "minWidth": 960,
        "minHeight": 640,
        "resizable": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' http://localhost:5173 ws://localhost:5173"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all"
  }
}
