{
  "name": "woho-ai-devkit",
  "version": "0.8.35",
  "private": true,
  "description": "Open-source AI developer toolkit for TypeScript and JavaScript.",
  "license": "Apache-2.0",
  "packageManager": "pnpm@10.17.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "pnpm -r build",
    "test": "pnpm -r test",
    "typecheck": "pnpm -r --sort build && pnpm -r typecheck",
    "pack:check": "pnpm -r --filter './packages/*' pack --pack-destination .release-packages",
    "release:check": "node scripts/check-release-graph.mjs",
    "consumer:check": "node scripts/consumer-smoke-check.mjs"
  },
  "keywords": [
    "ai",
    "agents",
    "typescript",
    "javascript",
    "developer-tools",
    "open-source"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/Monupatel62/woho-ai-devkit.git"
  },
  "homepage": "https://github.com/Monupatel62/woho-ai-devkit"
}
