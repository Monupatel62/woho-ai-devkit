{
  "name": "@woho/agents",
  "version": "0.3.9",
  "description": "Composable AI agents for WoHo AI DevKit.",
  "license": "Apache-2.0",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "dependencies": {
    "@woho/core": "workspace:*",
    "@woho/memory": "workspace:*",
    "@woho/mcp": "workspace:*"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "pnpm typecheck && pnpm build && node --experimental-strip-types src/index.test.ts"
  }
}
